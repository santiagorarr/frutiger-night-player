{
  "name": "frutiger-night-player",
  "version": "1.1.0",
  "description": "Reproductor MP3 estilo FRUTIGER NIGHT :))",
  "author": "Santiagoqwi",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.frutiger.nightplayer",
    "productName": "Frutiger Night Player",
    "files": ["main.js", "preload.js", "index.html", "styles.css", "app.js", "icon.ico"],
    "win": { "target": ["nsis", "portable" ], "icon": "icon.ico" },
    "nsis": { "artifactName": "FrutigerNightPlayer-Instalador-${version}.${ext}" },
    "portable": { "artifactName": "FrutigerNightPlayer-Portable-${version}.${ext}" }
    
  }
}