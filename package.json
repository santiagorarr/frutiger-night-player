{
  "name": "frutiger-night-player",
  "version": "1.2.0",
  "description": "Reproductor De Música estilo Frutiger Aero :))",
  "author": "Santiagoqwi",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder -mwl"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.frutiger.nightplayer",
    "productName": "Frutiger Night Player",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "app.js",
      "icon.ico",
      "icon.png"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "icon.ico"
    },
    "nsis": {
      "artifactName": "FrutigerNightPlayer-Instalador-${version}.${ext}"
    },
    "portable": {
      "artifactName": "FrutigerNightPlayer-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "icon.png",
      "artifactName": "FrutigerNightPlayer-${os}-${version}.${ext}"
    }
  }
}